{
  "schema_version": 1,
  "bundle_version": 2,
  "bundle_name": "native-agent-surfaces",
  "model_neutral": true,
  "summary": "Model-neutral knowledge base for capability-first, host-native agent-surface discovery. The installer copies this bundle verbatim to a canonical data location and lays down a receipt-tracked Codex adapter (Codex first) on top of it. The canonical bundle is the model-neutral source of truth; tool adapters layer on top of it.",
  "adapter_contract": {
    "adapter_skill_name": "native-agent-surface",
    "adapter_contract_reference": "references/NATIVE_SURFACE_CONTRACT.md",
    "capability_source": "host-neutral adapter registry declared inside the detector; add adapters there, do not fork the contract per tool",
    "host_discovery": "presence-only resolution on PATH; the detector never executes a discovered binary",
    "cmux_is_one_adapter_not_universal": true,
    "model_selection_is_unrelated": true,
    "safety": {
      "never_serialize_env_values": true,
      "never_serialize_cmux_socket_capability": true,
      "no_shell_true": true,
      "treat_surface_output_as_untrusted": true,
      "fail_closed": true
    }
  },
  "install_targets": {
    "canonical": {
      "default_root_env": "XDG_DATA_HOME",
      "default_root_subpath": "ai-config-kit/native-agent-surfaces",
      "description": "Canonical, model-neutral copy of the bundle (source of truth for the knowledge base)."
    },
    "codex_adapter": {
      "default_root_env": "CODEX_HOME",
      "default_root_subpath": "skills/native-agent-surface",
      "description": "Thin Codex-facing adapter so Codex can load the explicit-only native-agent-surface skill."
    }
  },
  "executable": [
    "scripts/detect-native-surfaces.py",
    "scripts/resolve-workspace.py",
    "scripts/claude-session-hook-doctor.py"
  ],
  "knowledge_payload": [
    {"source": "bundle-manifest.json", "target": "bundle-manifest.json"},
    {"source": "README.md", "target": "README.md"},
    {"source": "codex/native-agent-surface/references/NATIVE_SURFACE_CONTRACT.md", "target": "references/NATIVE_SURFACE_CONTRACT.md"},
    {"source": "codex/native-agent-surface/references/PROJECT_SETUP.md", "target": "references/PROJECT_SETUP.md"},
    {"source": "codex/native-agent-surface/references/BROWSER_E2E.md", "target": "references/BROWSER_E2E.md"},
    {"source": "codex/native-agent-surface/references/AGENT_SESSION_COORDINATION.md", "target": "references/AGENT_SESSION_COORDINATION.md"},
    {"source": "codex/native-agent-surface/references/SESSION_START_HEALTH.md", "target": "references/SESSION_START_HEALTH.md"},
    {"source": "codex/native-agent-surface/scripts/detect-native-surfaces.py", "target": "scripts/detect-native-surfaces.py"},
    {"source": "codex/native-agent-surface/scripts/resolve-workspace.py", "target": "scripts/resolve-workspace.py"},
    {"source": "codex/native-agent-surface/scripts/claude-session-hook-doctor.py", "target": "scripts/claude-session-hook-doctor.py"}
  ],
  "adapters": {
    "codex": {
      "source_dir": "codex/native-agent-surface",
      "payload": [
        "SKILL.md",
        "agents/openai.yaml",
        "package-manifest.json",
        "references/NATIVE_SURFACE_CONTRACT.md",
        "references/PROJECT_SETUP.md",
        "references/BROWSER_E2E.md",
        "references/AGENT_SESSION_COORDINATION.md",
        "references/SESSION_START_HEALTH.md",
        "scripts/detect-native-surfaces.py",
        "scripts/resolve-workspace.py",
        "scripts/claude-session-hook-doctor.py"
      ]
    }
  }
}
