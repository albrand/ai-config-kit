{
  "schemaVersion": 1,
  "board": "github",
  "boardUrl": "https://api.github.com",
  "repo": "acme-qa/project",
  "boardReadTokenEnv": "QA_BOARD_READ_TOKEN",
  "boardTokenEnv": "QA_BOARD_WRITE_TOKEN",
  "workItemPattern": "\\b[A-Z][A-Z0-9]+-\\d+\\b",
  "dryRun": true,
  "scenarioFile": "scenarios.json",
  "resultsFile": "run-v1.json",
  "compileCommand": [
    "npm",
    "run",
    "test:compile"
  ],
  "discoverCommand": [
    "npm",
    "run",
    "test:discover"
  ],
  "testCommand": [
    "npm",
    "test",
    "--",
    "--reporter=junit"
  ],
  "runner": "replace-with-runner-name",
  "resultFormat": "junit",
  "resultPath": "qa-results/junit.xml",
  "base": "origin/main",
  "authoritativePaths": [
    "scenarios.json",
    "tests"
  ],
  "environments": {
    "staging": {
      "origins": [
        "https://staging.example.invalid"
      ],
      "credentials": {
        "identities": [
          {
            "userEnv": "QA_STAGING_USER",
            "passwordEnv": "QA_STAGING_PASSWORD"
          }
        ],
        "deny": [
          "admin*",
          "*@personal.example.invalid"
        ]
      },
      "preflights": [
        "environment-ready"
      ],
      "cleanupCheck": [
        "node",
        "qa/cleanup-check.mjs"
      ]
    },
    "production": {
      "origins": [
        "https://app.example.invalid"
      ],
      "credentials": {
        "identities": [
          {
            "userEnv": "QA_PRODUCTION_USER",
            "passwordEnv": "QA_PRODUCTION_PASSWORD"
          }
        ],
        "deny": [
          "admin*",
          "*@personal.example.invalid"
        ]
      },
      "cleanupCheck": [
        "node",
        "qa/cleanup-check.mjs"
      ]
    }
  },
  "checks": {
    "environment-ready": [
      "node",
      "qa/preflight.mjs"
    ]
  }
}
