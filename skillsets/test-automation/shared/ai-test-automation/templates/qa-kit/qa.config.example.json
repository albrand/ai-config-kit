{
  "schemaVersion": 1,
  "board": "github",
  "boardUrl": "https://api.github.com",
  "repo": "acme-qa/project",
  "boardReadTokenEnv": "QA_BOARD_READ_TOKEN",
  "boardTokenEnv": "QA_BOARD_WRITE_TOKEN",
  "workItemPattern": "\\b[A-Z][A-Z0-9]+-\\d+\\b",
  "dryRun": true,
  "scenarioFile": "scenarios.json",
  "resultsFile": "run-v1.json",
  "compileCommand": ["npm", "run", "test:compile"],
  "discoverCommand": ["npm", "run", "test:discover"],
  "testCommand": ["npm", "test", "--", "--reporter=junit"],
  "runner": "replace-with-runner-name",
  "resultFormat": "junit",
  "resultPath": "qa-results/junit.xml",
  "base": "origin/main",
  "authoritativePaths": [
    "scenarios.json",
    "tests"
  ]
}
