#!/bin/sh
# QA ship gate, git pre-push layer: the one that also binds agents without
# PreToolUse hooks (opencode/GLM included). Install once per clone:
#   cp <skill-dir>/templates/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# (or vendor it as .qa/hooks/pre-push and set core.hooksPath, like the meu-psi pilot).
#
# v2: feature-branch pushes pass untouched -- a PR needs its preview built
# before anyone can walk it. Only pushes whose destination is protected (the
# remote default branch plus .qa/config.json protected_branches) must carry a
# complete .qa pipeline for the commit they send. The destination logic lives
# inside ship-gate.py itself (prepush), so this file has no parser of its own.
#
# v3: guarded. A branch with no .qa/config.json passes (not opted in); a branch
# whose config opts in but whose .qa/bin/ship-gate.py is missing gets a named
# deny instead of a python3 traceback on every push (pilot reproduction).
top="$(git rev-parse --show-toplevel)"
[ -f "$top/.qa/config.json" ] || exit 0
if [ ! -f "$top/.qa/bin/ship-gate.py" ]; then
  echo "[qa-ship-gate] .qa/config.json opts this branch in but .qa/bin/ship-gate.py is missing; restore it from the qa-sweep skill." >&2
  exit 1
fi
exec python3 "$top/.qa/bin/ship-gate.py" prepush "$@"
